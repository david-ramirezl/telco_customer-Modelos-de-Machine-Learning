   "source": [
    "#### Análisis de valores atípicos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "010f5fae",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "tenure: no presenta valores atípicos.\n",
      "MonthlyCharges: no presenta valores atípicos.\n",
      "TotalCharges: no presenta valores atípicos.\n"
     ]
    }
   ],
   "source": [
    "# buscar valores atípicos usando el rango intercuartil\n",
    "columnas_numericas = [\"tenure\", \"MonthlyCharges\", \"TotalCharges\"]\n",
    "\n",
    "for columna in columnas_numericas:\n",
    "    q1 = df[columna].quantile(0.25)\n",
    "    q3 = df[columna].quantile(0.75)\n",
    "    rango_intercuartil = q3 - q1\n",
    "\n",
    "    limite_inferior = q1 - 1.5 * rango_intercuartil\n",
    "    limite_superior = q3 + 1.5 * rango_intercuartil\n",
    "\n",
    "    valores_atipicos = df[\n",
    "        (df[columna] < limite_inferior) | (df[columna] > limite_superior)\n",
    "    ]\n",
    "\n",
    "    if len(valores_atipicos) > 0:\n",
    "        print(f\"{columna}: sí presenta valores atípicos ({len(valores_atipicos)} registros).\")\n",
    "    else:\n",
    "        print(f\"{columna}: no presenta valores atípicos.\")"
   ]
  },

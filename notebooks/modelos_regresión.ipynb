      ],
      "source": [
        "# convertir TotalCharges a numérico\n",
        "df[\"TotalCharges\"] = pd.to_numeric(df[\"TotalCharges\"], errors=\"coerce\")\n",
        "print(\"TotalCharges convertido a numérico.\")"

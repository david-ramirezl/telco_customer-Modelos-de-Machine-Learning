      "source": [
        "#### Análisis descriptivo de la variable tenure (antigüedad del cliente en meses)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 214,
      "id": "0250c360",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",

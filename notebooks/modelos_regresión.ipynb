          "output_type": "display_data"
        }
      ],
      "source": [
        "plt.figure(figsize=(5, 10))\n",
        "corr_target = matriz_corr[[\"tenure\"]].sort_values(\n",
        "    by=\"tenure\", ascending=False\n",
        ")\n",
        "\n",
        "sns.heatmap(\n",
        "    corr_target,\n",

        }
      ],
      "source": [
        "# mapa de calor matriz de correlaciones variables numéricas\n",
        "columnas = [\"tenure\", \"MonthlyCharges\", \"TotalCharges\"]\n",
        "\n",
        "correlacion_total = (\n",
        "    df[columnas]\n",
        "    .corr()[[\"tenure\"]]\n",
        "    .sort_values(\"tenure\", ascending=False)\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(5, 3))\n",
        "sns.heatmap(\n",
        "    correlacion_total,\n",
        "    annot=True,\n",
        "    cmap=\"coolwarm\",\n",
        "    vmin=-1,\n",
        "    vmax=1,\n",
        "    center=0,\n",
        "    fmt=\".2f\"\n",
        ")\n",
        "plt.title(\"Correlación con tenure\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 215,
      "id": "YJvPfCHVFvte",
      "metadata": {
        "id": "YJvPfCHVFvte"
      },
      "outputs": [],
      "source": [
        "# 1. Lista corregida: Incluye 'tenure' y elimina 'TechSupport' duplicado\n",
        "vars_analisis = [\n",
        "    \"tenure\",\n",
        "    \"TotalCharges\",\n",
        "    \"InternetService\",\n",
        "    \"TechSupport\",\n",
        "    \"MultipleLines\",\n",
        "    \"OnlineSecurity\",\n",
        "    \"OnlineBackup\",\n",
        "    \"DeviceProtection\",\n",
        "    \"gender\",\n",
        "    \"PaperlessBilling\",\n",
        "    \"SeniorCitizen\",\n",
        "    \"Partner\",\n",
        "    \"Dependents\",\n",
        "    \"PhoneService\",\n",
        "    \"Contract\",\n",
        "    \"StreamingTV\",\n",
        "    \"StreamingMovies\",\n",
        "    \"PaymentMethod\",\n",
        "    \"Churn\"\n",
        "]\n",
        "\n",
        "# 2. Aplicar pd.get_dummies()\n",
        "df_dummies = pd.get_dummies(df[vars_analisis], drop_first=False, dtype=int)\n",
        "\n",
        "# 3. Calcular la matriz de correlación de Pearson\n",
        "matriz_corr = df_dummies.corr(method=\"pearson\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 216,
      "id": "yKvfTfUUGQzy",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 853
        },
        "id": "yKvfTfUUGQzy",
        "outputId": "36e81802-e81e-45d9-fc48-f0ac8f562af4"
      },
      "outputs": [
        {
